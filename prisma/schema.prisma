generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  client
  admin
}

enum StockStatus {
  in_stock
  expected
  out_of_stock
}

enum AttributeType {
  number
  enum
  bool
  text
}

enum OrderStatus {
  new
  processing
  assembled
  shipped
  delivered
  cancelled
}

enum DeliveryMethod {
  pickup
  courier
  nova_poshta
}

enum PaymentMethod {
  cash
  card
  cod
  invoice
}

enum PaymentStatus {
  unpaid
  paid
}

model User {
  id                Int                  @id @default(autoincrement())
  email             String               @unique
  passwordHash      String               @map("password_hash")
  role              Role
  fullName          String               @map("full_name")
  phone             String?
  defaultAddress    String?              @map("default_address")
  isBlocked         Boolean              @default(false) @map("is_blocked")
  isDeleted         Boolean              @default(false) @map("is_deleted")
  passwordChangedAt DateTime             @default(now()) @map("password_changed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  orders            Order[]
  statusChanges     OrderStatusHistory[]

  @@map("users")
}

model Category {
  id            Int                 @id @default(autoincrement())
  name          String
  nameKey       String              @unique @map("name_key")
  slug          String              @unique
  parentId      Int?                @map("parent_id")
  parent        Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]          @relation("CategoryTree")
  sortOrder     Int                 @default(0) @map("sort_order")
  isVisible     Boolean             @default(true) @map("is_visible")
  importPattern String?             @map("import_pattern")
  createdAt     DateTime            @default(now()) @map("created_at")
  attributes    CategoryAttribute[]
  products      Product[]

  @@map("categories")
}

model CategoryAttribute {
  id           Int                     @id @default(autoincrement())
  categoryId   Int                     @map("category_id")
  category     Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  type         AttributeType
  unit         String?
  options      String[]
  isFilterable Boolean                 @default(false) @map("is_filterable")
  sortOrder    Int                     @default(0) @map("sort_order")
  values       ProductAttributeValue[]

  @@unique([categoryId, name])
  @@map("category_attributes")
}

model Manufacturer {
  id       Int       @id @default(autoincrement())
  name     String
  nameKey  String    @unique @map("name_key")
  country  String?
  products Product[]

  @@map("manufacturers")
}

model Product {
  id                    Int                     @id @default(autoincrement())
  supplierCode          String?                 @unique @map("supplier_code")
  sku                   String?
  name                  String
  slug                  String                  @unique
  categoryId            Int?                    @map("category_id")
  category              Category?               @relation(fields: [categoryId], references: [id])
  manufacturerId        Int?                    @map("manufacturer_id")
  manufacturer          Manufacturer?           @relation(fields: [manufacturerId], references: [id])
  price                 Decimal?                @db.Decimal(12, 2)
  supplierPrice         Decimal?                @map("supplier_price") @db.Decimal(12, 2)
  stockStatus           StockStatus             @map("stock_status")
  warrantyMonths        Int?                    @map("warranty_months")
  supplierImageUrl      String?                 @map("supplier_image_url")
  ownImagePath          String?                 @map("own_image_path")
  description           String?
  assemblyCountry       String?                 @map("assembly_country")
  assemblyCity          String?                 @map("assembly_city")
  isVisible             Boolean                 @default(false) @map("is_visible")
  isDeleted             Boolean                 @default(false) @map("is_deleted")
  updatedFromSupplierAt DateTime?               @map("updated_from_supplier_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  attributeValues       ProductAttributeValue[]
  orderItems            OrderItem[]

  @@index([categoryId, isVisible])
  @@index([manufacturerId])
  @@map("products")
}

model ProductAttributeValue {
  productId   Int               @map("product_id")
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId Int               @map("attribute_id")
  attribute   CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueNumber Float?            @map("value_number")
  valueText   String?           @map("value_text")
  valueBool   Boolean?          @map("value_bool")

  @@id([productId, attributeId])
  @@index([attributeId, valueNumber])
  @@index([attributeId, valueText])
  @@map("product_attribute_values")
}

model Order {
  id             Int                  @id @default(autoincrement())
  userId         Int                  @map("user_id")
  user           User                 @relation(fields: [userId], references: [id])
  clientOrderId  String               @map("client_order_id") @db.Uuid
  status         OrderStatus          @default(new)
  deliveryMethod DeliveryMethod       @map("delivery_method")
  deliveryAddress String?             @map("delivery_address")
  deliveryDate   DateTime?            @map("delivery_date") @db.Date
  deliverySlot   String?              @map("delivery_slot")
  paymentMethod  PaymentMethod        @map("payment_method")
  paymentStatus  PaymentStatus        @default(unpaid) @map("payment_status")
  contactName    String               @map("contact_name")
  contactPhone   String               @map("contact_phone")
  comment        String?
  adminNote      String?              @map("admin_note")
  total          Decimal              @db.Decimal(12, 2)
  statusChangedAt DateTime            @default(now()) @map("status_changed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  items          OrderItem[]
  history        OrderStatusHistory[]

  @@unique([userId, clientOrderId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, statusChangedAt])
  @@map("orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int     @map("order_id")
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int     @map("product_id")
  product     Product @relation(fields: [productId], references: [id])
  productName String  @map("product_name")
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          Int          @id @default(autoincrement())
  orderId     Int          @map("order_id")
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById Int          @map("changed_by")
  changedBy   User         @relation(fields: [changedById], references: [id])
  note        String?
  changedAt   DateTime     @default(now()) @map("changed_at")

  @@index([orderId, changedAt])
  @@map("order_status_history")
}
